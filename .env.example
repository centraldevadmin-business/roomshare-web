# Copy this file to `.env.local` and fill in your private GitHub repo.
# Never commit `.env.local` — it is gitignored.

# Your GitHub username (used only for display / attribution)
VITE_GITHUB_USER=your-github-username

# The private repo that will hold master_ledger.json
VITE_GITHUB_REPO=roomshare-data

# The Cloudflare Worker proxy URL. The GitHub token lives server-side in the
# Worker — it is NEVER in this file and NEVER in the app bundle.
# Deploy the Worker in workers/proxy.mjs, then set this to its URL.
VITE_WORKER_URL=https://roomshare-proxy.workers.dev

# The shared house password shown on the login gate. Anyone who knows it can
# enter the app. Keep it in .env.local only — never commit it.
VITE_HOUSE_PASSWORD=house2026
